PORT=5000
URL_API=http://localhost:5000
URL_FRONT_ADMIN=http://VERCEL_URL_FRONTEND_ADMIN
MONGO_URI=mongodb://localhost:27017/ulenguage
MONGO_URI_TEST=mongodb://localhost:27017/ulenguage_test
JWT_SECRET=ulenguage_super_secret_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GEMINI_API_KEY=your_gemini_api_key
NODE_ENV=production
# LOG_LEVEL controla el nivel de detalle de los logs de Winston
# Valores posibles:
#   error   → solo errores graves
#   warn    → advertencias y errores
#   info    → información general, advertencias y errores (por defecto)
#   debug   → todo, incluyendo detalles de depuración
LOG_LEVEL=info
GOOGLE_PLACES_API_KEY=your_google_places_api_key
DEPLOY_TOKEN=deploy_token_github_ulenguage2025